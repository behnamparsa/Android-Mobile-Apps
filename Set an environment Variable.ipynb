   "source": [
    "import os\n",
    "\n",
    "# Try to retrieve the token from environment variable\n",
    "token = os.getenv(\"GITHUB_TOKEN\")\n",
    "\n",
    "if token:\n",
    "    print(\"✅ Token is set correctly.\")\n",
    "    print(f\"🔒 Token starts with: {token[:10]}... (rest hidden)\")\n",
    "else:\n",
    "    print(\"❌ GITHUB_TOKEN is NOT set.\")\n"
   ]
  }
 ],
